@model IEnumerable<TempleWebsite.Models.Event>
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-overlay">
        <div class="container">
            <div class="row align-items-center min-vh-75">
                <div class="col-lg-6">
                    <div class="hero-content">
                        <h1 class="hero-title">Welcome to Sri Kaliyuga Ranganathar Temple</h1>
                        <p class="hero-subtitle">Experience divine blessings and spiritual peace in the sacred presence of Lord Ranganathar</p>
                        <div class="hero-buttons">
                            <a asp-controller="Donation" asp-action="Index" class="btn btn-temple btn-lg">Donate Now</a>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="hero-image">
                        <img src="~/images/ranganathar-idol.jpg.jpeg" alt="Lord Ranganathar" class="img-fluid temple-image">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Daily Timings Section -->
<section class="timings-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-4">
                <h2 class="section-title">Temple Timings</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="timing-card">
                    <i class="fas fa-sun timing-icon"></i>
                    <h5>Nitya Dharshan</h5>
                    <p>Morning 7 AM - 9 AM<br><small>(Nithya Pooja)</small></p>
                    <p>Saturday & Amavashya<br>12 PM - 4 PM<br><small>(with Annadhana)</small></p>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="timing-card">
                    <i class="fas fa-pray timing-icon"></i>
                    <h5>Special Poojas</h5>
                    <p>6 PM - 9 PM<br><small>(with Annadhana)</small></p>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="timing-card">
                    <i class="fas fa-star timing-icon"></i>
                    <h5>Abhisega Dharshana</h5>
                    <p>3 days before<br>Saturday & Amavashya</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Featured Events Section -->
@if (Model.Any())
{
    <section class="events-section py-5 bg-light">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center mb-4">
                    <h2 class="section-title">Upcoming Events</h2>
                </div>
            </div>
            <div class="col-lg-8 mx-auto">
                <ul class="list-group list-group-flush">
                    @foreach (var eventItem in Model)
                    {
                        <li class="list-group-item d-flex align-items-start py-3 px-0 border-bottom">
                            <div class="event-date-badge me-3 text-center flex-shrink-0">
                                <div class="fw-bold fs-4 lh-1">@eventItem.EventDate.Day</div>
                                <div class="text-uppercase small">@eventItem.EventDate.ToString("MMM")</div>
                                <div class="small text-muted">@eventItem.EventDate.Year</div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@eventItem.Title</div>
                                <div class="text-muted small">@eventItem.Description</div>
                                <div class="small mt-1">
                                    @if (!string.IsNullOrEmpty(eventItem.EventTime))
                                    {
                                        <span class="me-2"><i class="fas fa-clock"></i> @eventItem.EventTime</span>
                                    }
                                    @if (!string.IsNullOrEmpty(eventItem.Day))
                                    {
                                        <span class="badge bg-secondary">@eventItem.Day</span>
                                    }
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Events" asp-action="Index" class="btn btn-temple">View All Events</a>
            </div>
        </div>
    </section>
}

<style>
.event-date-badge {
    min-width: 50px;
    color: var(--temple-primary, #e67e22);
}
</style>

<!-- Services Section -->
<section class="services-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-12 text-center mb-4">
                <h2 class="section-title">Our Services</h2>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="service-card text-center">
                    <i class="fas fa-calendar-alt service-icon"></i>
                    <h4>Events & Festivals</h4>
                    <p>Participate in traditional festivals and spiritual events throughout the year.</p>
                    <a asp-controller="Events" asp-action="Index" class="btn btn-outline-temple">View Events</a>
                </div>
            </div>
            <div class="col-md-6 mb-4">
                <div class="service-card text-center">
                    <i class="fas fa-heart service-icon"></i>
                    <h4>Donations</h4>
                    <p>Support temple activities and contribute to the spiritual community.</p>
                    <a asp-controller="Donation" asp-action="Index" class="btn btn-outline-temple">Donate Now</a>
                </div>
            </div>
        </div>
    </div>
</section>