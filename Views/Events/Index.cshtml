@model IEnumerable<TempleWebsite.Models.Event>
@{
    ViewData["Title"] = "Events & Festivals";
}

<div class="page-header">
    <div class="container">
        <h1>Events & Festivals</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active">Events</li>
            </ol>
        </nav>
    </div>
</div>

<section class="events-listing py-5">
    <div class="container">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessages"] != null)
        {
            var errors = System.Text.Json.JsonSerializer.Deserialize<List<string>>(TempData["ErrorMessages"]!.ToString()!);
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Upload errors:</strong>
                <ul class="mb-0 mt-1">
                    @foreach (var err in errors!)
                    {
                        <li>@err</li>
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="mb-3">
                <button type="button" class="btn btn-outline-secondary" onclick="toggleUploadPanel()">Edit Events</button>
            </div>

            <div id="uploadPanel" style="display:none;" class="card mb-4 p-3">
                <form method="post" asp-action="Upload" asp-controller="Events" enctype="multipart/form-data" class="mb-3">
                    <div class="mb-2">
                        <input type="file" name="file" accept=".xls,.xlsx" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary">Upload Events</button>
                </form>

                <form method="post" asp-action="Logout" asp-controller="Account">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Logout</button>
                </form>
            </div>

            <script>
                function toggleUploadPanel() {
                    var panel = document.getElementById('uploadPanel');
                    panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
                }
            </script>
        }

        <div class="row">
            <div class="col-12 text-center mb-4">
                <h2 class="section-title">Upcoming Events & Festivals</h2>
                <p class="lead">Join us in celebrating divine festivals and spiritual events throughout the year</p>
            </div>
        </div>

        @if (Model.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var eventItem in Model)
                {
                    <li class="list-group-item d-flex align-items-start py-3 px-0 border-bottom">
                        <div class="event-date-badge me-3 text-center flex-shrink-0">
                            <div class="fw-bold fs-4 lh-1">@eventItem.EventDate.Day</div>
                            <div class="text-uppercase small">@eventItem.EventDate.ToString("MMM")</div>
                            <div class="small text-muted">@eventItem.EventDate.Year</div>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold fs-6">@eventItem.Title</div>
                            <div class="text-muted small">@eventItem.Description</div>
                            <div class="small mt-1">
                                @if (!string.IsNullOrEmpty(eventItem.EventTime))
                                {
                                    <span class="me-2"><i class="fas fa-clock"></i> @eventItem.EventTime</span>
                                }
                                @if (!string.IsNullOrEmpty(eventItem.Day))
                                {
                                    <span class="badge bg-secondary">@eventItem.Day</span>
                                }
                                @if (eventItem.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark ms-1">Featured</span>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="text-center py-5">
                <p class="lead text-muted">No upcoming events at this time. Please check back later.</p>
            </div>
        }
    </div>
</section>

<style>
.events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.event-grid-item {
    background: white;
    border-radius: 15px;
    padding: 1.5rem;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border-top: 4px solid var(--temple-primary);
    height: 100%;
    display: flex;
    flex-direction: column;
}

.event-grid-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
}

.event-date-circle {
    background: var(--temple-gradient);
    color: white;
    border-radius: 50%;
    width: 80px;
    height: 80px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1rem;
    box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3);
}

.date-day {
    font-size: 1.6rem;
    font-weight: bold;
    line-height: 1;
}

.date-month {
    font-size: 0.9rem;
    opacity: 0.9;
}

.event-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.event-title {
    color: var(--temple-accent);
    margin-bottom: 1rem;
    font-weight: 600;
    font-size: 1.1rem;
}

.event-desc {
    color: #666;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
    flex: 1;
}

.event-timing {
    color: var(--temple-primary);
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
}

.event-date-badge {
    min-width: 50px;
    color: var(--temple-primary, #e67e22);
}

.day-badge {
    background: var(--temple-primary, #e67e22);
    color: white;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.75rem;
    font-weight: 600;
}

.featured-tag {
    background: var(--temple-secondary);
    color: white;
    padding: 4px 12px;
    border-radius: 15px;
    font-size: 0.75rem;
    font-weight: bold;
    display: inline-block;
    margin-top: 0.5rem;
}

@@media (max-width: 768px) {
    .events-grid {
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.5rem;
    }
}
</style>
